{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "apiVersion": 1,
  "id": "git-status",
  "name": "Git Status",
  "version": "1.0.0",
  "description": "Safe read-only CLI plugin to inspect git status in the workspace.",
  "icon": "GitBranch",
  "trust": "first-party",
  "permissions": [
    {
      "type": "exec",
      "commands": ["git"]
    },
    {
      "type": "fs",
      "scope": "city",
      "mode": "read"
    }
  ],
  "capabilities": [
    {
      "id": "git-status.check",
      "title": "Git Status Check",
      "description": "Run git status in porcelain format to inspect workspace changes",
      "risk": "read",
      "adapter": {
        "cli": {
          "bin": "git",
          "args": ["status", "--porcelain"],
          "workingDir": "city"
        }
      },
      "input": {
        "type": "object",
        "properties": {}
      }
    }
  ]
}
