{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "apiVersion": 1,
  "id": "hello",
  "name": "Hello World",
  "version": "1.0.0",
  "description": "Minimal reference plugin with one capability and one surface.",
  "icon": "HandWaving",
  "trust": "first-party",
  "surfaces": [
    {
      "id": "hello.view",
      "title": "Hello Card",
      "icon": "HandWaving",
      "variant": "floating",
      "entry": "index.html"
    }
  ],
  "capabilities": [
    {
      "id": "hello.greet",
      "title": "Greet User",
      "description": "Return a friendly greeting message for the user",
      "risk": "read",
      "adapter": {
        "http": {
          "method": "GET",
          "urlTemplate": "https://en.wikipedia.org/api/rest_v1/page/summary/{name}",
          "byteCap": 1048576
        }
      },
      "input": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name or topic to greet"
          }
        },
        "required": ["name"]
      }
    }
  ],
  "permissions": [
    {
      "type": "net",
      "hosts": ["en.wikipedia.org"]
    }
  ]
}
