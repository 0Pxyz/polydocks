{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "apiVersion": 1,
  "id": "wikipedia",
  "name": "Wikipedia Summary",
  "version": "1.0.0",
  "description": "Fetch concise Wikipedia summaries and extracts via public REST API.",
  "icon": "BookOpen",
  "trust": "first-party",
  "permissions": [
    {
      "type": "net",
      "hosts": ["en.wikipedia.org"]
    }
  ],
  "capabilities": [
    {
      "id": "wikipedia.summary",
      "title": "Wikipedia Summary",
      "description": "Fetch the summary and extract of a Wikipedia article by title",
      "risk": "read",
      "adapter": {
        "http": {
          "method": "GET",
          "urlTemplate": "https://en.wikipedia.org/api/rest_v1/page/summary/{title}",
          "byteCap": 1048576,
          "headers": {
            "User-Agent": "Polymax/1.0 (https://github.com/0Pxyz/polymax)"
          }
        }
      },
      "input": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "The title of the Wikipedia page (e.g. 'Philosophy', 'Stoicism')"
          }
        },
        "required": ["title"]
      }
    }
  ]
}
