# Meta Model API Base URL (default: https://api.meta.ai/v1)
MODEL_BASE_URL=https://api.meta.ai/v1

# Meta Model Identifier (default: muse-spark-1.3)
MODEL_ID=muse-spark-1.3

# Meta Model API Bearer Key (dev.meta.ai)
MODEL_API_KEY=

# Optional per-role model overrides (defaults shown)
MODEL_AGENT_ID=muse-spark-1.3
MODEL_FAST_ID=muse-spark-1.3
MODEL_VISION_ID=
MODEL_IMAGE_ID=muse-image-1.0
MODEL_SEGMENTATION_ID=sam-3.1

# Orchestrator / heavy-agent roles (#210): canonical names first, legacy
# per-role ids as fallback. Either model fills either role by
# configuration only — no provider switch in code.
# ORCHESTRATOR_MODEL falls back to MODEL_FAST_ID (default: muse-spark-1.3).
ORCHESTRATOR_MODEL=
# AGENT_MODEL falls back to MODEL_AGENT_ID then MODEL_ID. Preview example:
# AGENT_MODEL=muse-wonder-1.0 (confirm availability with GET /v1/models).
AGENT_MODEL=
# Reasoning effort per role: low for the orchestrator, higher for the
# heavy agent (e.g. AGENT_EFFORT=high). Empty = model decides.
ORCHESTRATOR_EFFORT=low
AGENT_EFFORT=

# Voice realtime (defaults: wss://api.meta.ai/v1/asr/realtime + muse-voice-transcribe-1.0)
MODEL_REALTIME_URL=wss://api.meta.ai/v1/asr/realtime
MODEL_VOICE_MODEL=muse-voice-transcribe-1.0

# Open-weight agent toggle (Baseten / Modal / self-hosted, OpenAI-compatible).
# Set AGENT_PROVIDER=openweight + the three below to run the agent on
# meta-models/muse-spark-open-1026 without touching any plugin.
AGENT_PROVIDER=meta
OPENWEIGHT_BASE_URL=
OPENWEIGHT_API_KEY=
OPENWEIGHT_MODEL_ID=meta-models/muse-spark-open-1026

# TinyFish Search & Fetch API Key for autonomous web discovery (docs.tinyfish.ai)
TINYFISH_API_KEY=

# Modal Sandboxes (agent code execution): Token ID + Secret for the Modal
# client (or `modal setup` writing ~/.modal.toml). Unset = sandbox tools
# fail closed; the rest of the app keeps working. See docs/sandbox.md.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Atrium remote browser (first-party Browser surface): Chromium worker dial
# URL + shared secret. Dev: run `ATRIUM_WORKER_SECRET=dev-secret-change-me
# npx atrium-worker` (needs `npx playwright install chromium` once).
# Unset secret = browser surface falls back to the Reader, /api/browser/*
# returns browser_unavailable. Never expose the secret to the frontend.
# Headless (no local Chrome window; the only view is <RemoteBrowser />):
# export ATRIUM_WORKER_HEADLESS=1 when launching the worker. Keep
# ATRIUM_CHROMIUM_CHANNEL unset to use the Playwright-bundled Chromium
# instead of system Chrome.
ATRIUM_WORKER_DIAL_BASE=ws://127.0.0.1:7070
ATRIUM_WORKER_SECRET=
ATRIUM_WORKER_HEADLESS=1

# Identity foundation (Better Auth 1.7.x). Everything here is optional:
# local development works with all of them unset.
# Long random secret for signing sessions. REQUIRED in production
# (the server refuses to boot without it). Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL of this server (used for OAuth callbacks and email links).
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth (https://console.cloud.google.com/apis/credentials).
# Both must be set to enable; unset = Google sign-in hidden in the UI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub OAuth (https://github.com/settings/developers).
# Both must be set to enable; unset = GitHub sign-in hidden in the UI.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Outbound email (verification + password reset). Unset = the server logs
# the link and keeps it in a dev outbox instead of sending (see docs/auth.md).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Daily cap on Muse Image generations (covers, share cards). Requests
# beyond the cap fail with budget_exceeded instead of spending ($0.01/image).
IMAGE_MAX_PER_DAY=25

# Agent tool surface:
# full (default, current catalog) or minimal (intent-scoped: dock verbs +
# find_capabilities + plugins.create/edit/install/uninstall/operate; more loads by intent).
# plugins.install ships on every surface.
PRODUCT_SURFACE=facade
AGENT_SURFACE=full

# Install policy for agent-originated plugin lifecycle (create/install/
# publish): ask = needs { userApproved: true } (default), auto = proceed,
# never = always deny. actor=user|cli counts as an explicit human action.
INSTALL_POLICY=ask

# Server HTTP listening port (default: 3000)
PORT=3000

# SQLite and city workspace runtime data directory (default: ./data)
DATA_DIR=./data

# MCP: PolyDocks as a server (any MCP client connects at POST /mcp,
# Streamable HTTP stateless) and as a client (connect external servers).
# MCP_SERVERS_JSON: preconfigured outbound servers, e.g.
# [{"name":"github","url":"https://mcp.example.com/mcp","tokenEnv":"GH_MCP_TOKEN"}]
# Use tokenEnv (env var name), never an inline token.
MCP_SERVERS_JSON=
# Stdio transports spawn local processes: default deny, opt in explicitly.
MCP_ALLOW_STDIO=
