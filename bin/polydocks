#!/usr/bin/env bun
import { config } from "../server/config";
import { db } from "../server/workspace/db";
import {
  WorkspaceService,
  SessionService,
  TaskService,
  PluginService,
} from "../server/services";
import { runAgentLoop, type AgentStepEvent } from "../server/agent/loop";

interface CliOptions {
  json: boolean;
  workspace?: string;
  session?: string;
  status?: string;
  fromStep?: number;
  city?: string;
  maxSteps?: number;
}

function parseCliArgs(args: string[]): {
  command: string;
  subcommand?: string;
  positional: string[];
  options: CliOptions;
} {
  const options: CliOptions = {
    json: false,
  };
  const positional: string[] = [];

  for (let i = 0; i < args.length; i++) {
    const arg = args[i];
    if (arg === "--json") {
      options.json = true;
    } else if (arg === "--workspace" || arg === "-w") {
      options.workspace = args[++i];
    } else if (arg === "--session" || arg === "-s") {
      options.session = args[++i];
    } else if (arg === "--status") {
      options.status = args[++i];
    } else if (arg === "--from-step") {
      options.fromStep = parseInt(args[++i], 10);
    } else if (arg === "--city") {
      options.city = args[++i];
    } else if (arg === "--max-steps") {
      options.maxSteps = parseInt(args[++i], 10);
    } else if (!arg.startsWith("-")) {
      positional.push(arg);
    }
  }

  const command = positional[0] || "help";
  const subcommand = positional[1];
  const restPositional = positional.slice(2);

  return {
    command,
    subcommand,
    positional: restPositional,
    options,
  };
}

function printUsage(): void {
  console.log(`
PolyDocks CLI - Agent Runtime & Workspace Operator

USAGE:
  polydocks <command> [subcommand] [arguments] [options]

COMMANDS:
  status                               Show runtime health, SQLite WAL, and active counts
  sessions list [--workspace <id>]     List active and historical work sessions
  sessions resume <sessionId>          Inspect and tail session transcript
  tasks list [--status <status>]       List background tasks and progress
  plugins list [--workspace <id>]      List installed plugins
  plugins inspect <pluginId>           Inspect plugin manifest and capabilities
  plugins install <pluginId>           Install plugin into active workspace
  plugins invoke <plugin> <capability> [--k v] [--city <id>]
                                       Same handler as POST /api/plugins/:id/:capability
  plugins lifecycle --op <create|modify|publish|install|uninstall> [--k v]
                                       Same handler as POST /api/plugins/lifecycle
  plugins versions <pluginId>          List kept versions (edit history)
  plugins rollback <pluginId> --version <v> [--workspace <id>]
                                       Roll back to a kept version
  dock tabs [--city <id>]              List dock tabs (same as GET /api/dock/tabs)
  dock action --op <op> [--k v] [--city <id>]
                                       Dock verb (same as POST /api/dock/action)
  dock open <tabId> | close|pin|unpin <id> | list [--city <id>]
                                       Verb shortcuts (tabs.open/close/pin/unpin/list)
  dock focus <index> | next | prev | background <id> | chat-toggle
                                       Focus shortcuts (tabs.focus/next/prev/background, chat.toggle)
  dock scope <cityId>                  Enter a city scope (same as POST /api/dock/scope)
  dock appearance [--theme x ...]      Apply appearance (same as POST /api/dock/appearance)
  agent run "<prompt>"                 Run agent instruction directly in terminal
  agent status | models                 Runtime status / model roles (same as /api/agent/*)
  agent memory|task|approve|session --op <op> [--k v]
                                       Agent surface (same as /api/agent/*)
  <plugin> <capability> [--k v]      Run a contract capability (sources, cities, ...)
                                     e.g. polydocks sources add --url https://... --city biohacking --json

GLOBAL OPTIONS:
  --json                               Output machine-readable JSON on stdout
  --workspace, -w <id>                 Target workspace ID
  --help, -h                           Show this help menu
`);
}

async function handleStatus(options: CliOptions): Promise<void> {
  let walMode = "unknown";
  try {
    const res = db.query<any, []>("PRAGMA journal_mode;").get();
    walMode = res?.journal_mode || "ok";
  } catch {
    walMode = "error";
  }

  const workspaces = WorkspaceService.listWorkspaces();
  const defaultWs = workspaces.find((w) => w.isDefault) || workspaces[0];
  const sessions = SessionService.listSessions();
  const runningTasks = TaskService.listTasks({ status: "running" });
  const plugins = PluginService.listPlugins();

  const data = {
    status: "ok",
    port: config.PORT,
    env: config.NODE_ENV,
    sqlite: {
      wal: walMode,
      ok: walMode === "wal" || walMode !== "error",
    },
    model: {
      id: config.MODEL_ID,
      configured: Boolean(config.MODEL_API_KEY && config.MODEL_API_KEY.trim().length > 0),
    },
    tinyfish: {
      configured: Boolean(config.TINYFISH_API_KEY && config.TINYFISH_API_KEY.trim().length > 0),
    },
    activeWorkspace: defaultWs ? { id: defaultWs.id, name: defaultWs.name } : null,
    counts: {
      workspaces: workspaces.length,
      sessions: sessions.length,
      runningTasks: runningTasks.length,
      installedPlugins: plugins.length,
    },
  };

  if (options.json) {
    console.log(JSON.stringify(data, null, 2));
    return;
  }

  console.log("==================================================");
  console.log("  PolyDocks Runtime Status                        ");
  console.log("==================================================");
  console.log(`Port:             ${data.port}`);
  console.log(`Environment:      ${data.env}`);
  console.log(`SQLite WAL:       ${data.sqlite.wal.toUpperCase()}`);
  console.log(`Model ID:         ${data.model.id} (${data.model.configured ? "configured" : "unconfigured"})`);
  console.log(`TinyFish:         ${data.tinyfish.configured ? "configured" : "unconfigured"}`);
  console.log(`Active Workspace: ${data.activeWorkspace?.name || "None"} (${data.activeWorkspace?.id || "-"})`);
  console.log("--------------------------------------------------");
  console.log(`Workspaces:       ${data.counts.workspaces}`);
  console.log(`Total Sessions:   ${data.counts.sessions}`);
  console.log(`Running Tasks:    ${data.counts.runningTasks}`);
  console.log(`Installed Tools:  ${data.counts.installedPlugins}`);
  console.log("==================================================");
}

async function handleSessions(
  subcommand: string | undefined,
  posArgs: string[],
  options: CliOptions
): Promise<void> {
  if (subcommand === "list" || !subcommand) {
    const list = SessionService.listSessions(options.workspace);
    if (options.json) {
      console.log(JSON.stringify(list, null, 2));
      return;
    }

    if (list.length === 0) {
      console.log("No work sessions found.");
      return;
    }

    console.log("ID\t\t\t\tWORKSPACE\tSTATUS\t\tTITLE");
    console.log("--------------------------------------------------------------------------------");
    for (const s of list) {
      console.log(`${s.id}\t${s.workspaceId}\t\t${s.status.padEnd(10)}\t${s.title || "Untitled"}`);
    }
    return;
  }

  if (subcommand === "resume") {
    const sessionId = posArgs[0] || options.session;
    if (!sessionId) {
      console.error("Error: Missing required sessionId for 'sessions resume <sessionId>'");
      process.exit(1);
    }

    const session = SessionService.getSession(sessionId);
    if (!session) {
      console.error(`Error: Session "${sessionId}" not found.`);
      process.exit(1);
    }

    const transcript = await SessionService.getTranscript(sessionId, {
      offset: options.fromStep,
      rootDir: process.env.AGENT_HOME_DIR,
    });

    if (options.json) {
      console.log(JSON.stringify({ session, transcript }, null, 2));
      return;
    }

    console.log(`Session: ${session.title || session.id} [${session.status}]`);
    console.log(`Workspace: ${session.workspaceId} | Created: ${session.createdAt}`);
    console.log("--------------------------------------------------");
    for (const turn of transcript) {
      const type = turn.type || "event";
      const payload = turn.payload ? JSON.stringify(turn.payload) : "";
      console.log(`[${turn.timestamp || "T"}] Step ${turn.step ?? "-"}: ${type} ${payload}`);
    }
    return;
  }

  console.error(`Unknown sessions subcommand "${subcommand}". Use "list" or "resume".`);
  process.exit(1);
}

async function handleTasks(
  subcommand: string | undefined,
  options: CliOptions
): Promise<void> {
  if (subcommand === "list" || !subcommand) {
    const tasks = TaskService.listTasks({
      status: options.status,
      sessionId: options.session,
      workspaceId: options.workspace,
    });

    if (options.json) {
      console.log(JSON.stringify(tasks, null, 2));
      return;
    }

    if (tasks.length === 0) {
      console.log("No background tasks found.");
      return;
    }

    console.log("ID\t\t\t\tTYPE\t\tSTATUS\t\tPROGRESS\tSESSION");
    console.log("--------------------------------------------------------------------------------");
    for (const t of tasks) {
      const progress = `${Math.round(t.progress * 100)}%`.padEnd(8);
      console.log(`${t.id}\t${t.type.padEnd(12)}\t${t.status.padEnd(10)}\t${progress}\t${t.sessionId}`);
    }
    return;
  }

  console.error(`Unknown tasks subcommand "${subcommand}". Use "list".`);
  process.exit(1);
}

async function handlePlugins(
  subcommand: string | undefined,
  posArgs: string[],
  options: CliOptions
): Promise<void> {
  if (subcommand === "list" || !subcommand) {
    if (options.workspace) {
      const wsPlugins = WorkspaceService.listWorkspacePlugins(options.workspace);
      if (options.json) {
        console.log(JSON.stringify(wsPlugins, null, 2));
        return;
      }
      console.log(`Plugins in workspace "${options.workspace}":`);
      for (const p of wsPlugins) {
        console.log(`- ${p.pluginId} (enabled: ${p.enabled})`);
      }
      return;
    }

    const all = PluginService.listPlugins();
    if (options.json) {
      console.log(JSON.stringify(all, null, 2));
      return;
    }

    console.log("ID\t\t\tVERSION\tTRUST\t\tNAME");
    console.log("--------------------------------------------------------------------------------");
    for (const p of all) {
      console.log(`${p.id.padEnd(20)}\tv${p.version}\t${p.trust.padEnd(10)}\t${p.name}`);
    }
    return;
  }

  if (subcommand === "inspect") {
    const pluginId = posArgs[0];
    if (!pluginId) {
      console.error("Error: Missing required pluginId for 'plugins inspect <pluginId>'");
      process.exit(1);
    }

    const plugin = PluginService.getPlugin(pluginId);
    if (!plugin) {
      console.error(`Error: Plugin "${pluginId}" not found.`);
      process.exit(1);
    }

    if (options.json) {
      console.log(JSON.stringify(plugin, null, 2));
      return;
    }

    console.log(`Plugin: ${plugin.name} (${plugin.id}) v${plugin.version}`);
    console.log(`Trust: ${plugin.trust} | Enabled: ${plugin.enabled}`);
    console.log(`Description: ${plugin.manifest.description}`);
    console.log("Capabilities:");
    for (const cap of plugin.manifest.capabilities || []) {
      console.log(`  - [${cap.risk || "read"}] ${cap.id}: ${cap.description}`);
    }
    return;
  }

  if (subcommand === "install") {
    const pluginId = posArgs[0];
    if (!pluginId) {
      console.error("Error: Missing required pluginId for 'plugins install <pluginId>'");
      process.exit(1);
    }

    const workspaceId = options.workspace || "default";
    // Same no-ghost-mount rule as the lifecycle route: unknown ids fail.
    const { pluginLifecycle } = await import("../server/facade/shared");
    const out = await pluginLifecycle("install", { pluginId, workspaceId }, { actor: "cli", workspaceId });
    if (options.json) {
      console.log(JSON.stringify(out.ok ? { success: true, mounted: (out as any).data } : out, null, 2));
      process.exit(out.ok ? 0 : 1);
    }
    if (out.ok) {
      console.log(`Successfully installed plugin "${pluginId}" into workspace "${workspaceId}".`);
      return;
    }
    console.error(`Error: ${(out as any).error || "Install failed."}`);
    process.exit(1);
  }

  console.error(`Unknown plugins subcommand "${subcommand}". Use "list", "inspect", "install", "invoke", "lifecycle", "versions", or "rollback".`);
  process.exit(1);
}

function printEnvelope(envelope: unknown, options: CliOptions): void {
  if (options.json) {
    console.log(JSON.stringify(envelope, null, 2));
    return;
  }
  const env = envelope as any;
  if (env?.ok) {
    const data = env.data;
    console.log(typeof data === "string" ? data : JSON.stringify(data, null, 2));
    for (const e of env.events ?? []) {
      console.log(`[event ${e.type}]`);
    }
  } else {
    console.error(`Error: ${env?.error || "Failed."}${env?.code ? ` (${env.code})` : ""}`);
  }
}

function facadeCtx(options: CliOptions) {
  return { actor: "cli" as const, cityId: options.city, workspaceId: options.workspace };
}

/** plugins invoke <plugin> <capability> [--k v] — same handler as the route. */
async function handlePluginsInvoke(
  posArgs: string[],
  rawTail: string[],
  options: CliOptions
): Promise<void> {
  const [pluginId, capability, ...rest] = posArgs;
  if (!pluginId || !capability) {
    console.error('Error: Usage: polydocks plugins invoke <plugin> <capability> [--key value] [--city <id>]');
    process.exit(1);
  }
  const { parseContractFlags } = await import("../server/plugins/contractCli");
  const { input, city } = parseContractFlags([...rest, ...rawTail]);
  const { invokeCapability } = await import("../server/facade/shared");
  const out = await invokeCapability(pluginId, capability, input, {
    ...facadeCtx(options),
    cityId: options.city || city,
  });
  printEnvelope(out, options);
  process.exit(out.ok ? 0 : 1);
}

/** plugins lifecycle --op <create|modify|publish|install> — same handler as the route. */
async function handlePluginsLifecycle(
  _posArgs: string[],
  rawTail: string[],
  options: CliOptions
): Promise<void> {
  const { parseContractFlags } = await import("../server/plugins/contractCli");
  const { input } = parseContractFlags(rawTail);
  const { pluginLifecycle } = await import("../server/facade/shared");
  const op = (input as any).op;
  if (typeof op !== "string") {
    console.error("Error: Usage: polydocks plugins lifecycle --op <create|modify|publish|install> [--key value]");
    process.exit(1);
  }
  const { op: _op, ...params } = input;
  const out = await pluginLifecycle(op, params, {
    ...facadeCtx(options),
    cityId: options.city || (params as any).cityId,
    workspaceId: options.workspace || (params as any).workspaceId,
  });
  printEnvelope(out, options);
  process.exit(out.ok ? 0 : 1);
}

/** plugins versions <pluginId> | plugins rollback <pluginId> --version <v>. */
async function handlePluginsVersions(
  posArgs: string[],
  rawTail: string[],
  subcommand: string,
  options: CliOptions
): Promise<void> {
  const { parseContractFlags } = await import("../server/plugins/contractCli");
  const { input } = parseContractFlags(rawTail);
  const shared = await import("../server/facade/shared");
  const pluginId = posArgs[0] || (input as any).pluginId;
  if (!pluginId) {
    console.error(`Error: Usage: polydocks plugins ${subcommand} <pluginId> [--version <v>]`);
    process.exit(1);
  }
  const out =
    subcommand === "versions"
      ? await shared.pluginVersions(pluginId)
      : await shared.pluginRollback(pluginId, (input as any).version, options.workspace || (input as any).workspaceId);
  printEnvelope(out, options);
  process.exit((out as any)?.ok ? 0 : 1);
}

/** dock <tabs|action|scope|appearance> — same handlers as /api/dock. */
async function handleDock(
  subcommand: string | undefined,
  posArgs: string[],
  rawTail: string[],
  options: CliOptions
): Promise<void> {
  const { dockAction } = await import("../server/facade/shared");
  const { parseContractFlags } = await import("../server/plugins/contractCli");
  if (subcommand === "tabs" || !subcommand) {
    const out = await dockAction("tabs.list", options.city ? { cityId: options.city } : {}, facadeCtx(options));
    printEnvelope(out, options);
    process.exit(out.ok ? 0 : 1);
  }
  // Verb shortcuts: dock open|close|pin|unpin|list|focus|next|prev|background|chat-toggle — same as action --op tabs.*.
  const verbOp: Record<string, string> = {
    open: "tabs.open",
    close: "tabs.close",
    pin: "tabs.pin",
    unpin: "tabs.unpin",
    list: "tabs.list",
    focus: "tabs.focus",
    next: "tabs.next",
    prev: "tabs.prev",
    background: "tabs.background",
    "chat-toggle": "chat.toggle",
  };
  if (subcommand && verbOp[subcommand]) {
    const id = posArgs[0];
    const params: Record<string, unknown> = {};
    if (subcommand === "open") {
      if (!id) {
        console.error("Error: Usage: polydocks dock open <tabId> [--city <id>]");
        process.exit(1);
      }
      params.tabId = id;
    } else if (subcommand === "focus") {
      const index = Number(id);
      if (!Number.isInteger(index) || index < 0) {
        console.error("Error: Usage: polydocks dock focus <index> [--city <id>]");
        process.exit(1);
      }
      params.index = index;
    } else if (subcommand === "background") {
      if (!id) {
        console.error("Error: Usage: polydocks dock background <id> [--city <id>]");
        process.exit(1);
      }
      params.id = id;
    } else if (subcommand === "next" || subcommand === "prev" || subcommand === "chat-toggle" || subcommand === "list") {
      if (id && subcommand === "list") {
        console.error("Error: Usage: polydocks dock list [--city <id>]");
        process.exit(1);
      }
    } else if (subcommand !== "list") {
      if (!id) {
        console.error(`Error: Usage: polydocks dock ${subcommand} <id> [--city <id>]`);
        process.exit(1);
      }
      params.id = id;
    }
    if (options.city) params.cityId = options.city;
    if (options.workspace) params.workspaceId = options.workspace;
    const out = await dockAction(verbOp[subcommand], params, facadeCtx(options));
    printEnvelope(out, options);
    process.exit(out.ok ? 0 : 1);
  }
  if (subcommand === "action") {
    const { input } = parseContractFlags(rawTail);
    const { op, ...params } = input as Record<string, unknown>;
    if (typeof op !== "string") {
      console.error('Error: dock action needs --op <tabs.list|tabs.open|tabs.pin|tabs.unpin|tabs.close|tabs.focus|tabs.next|tabs.prev|tabs.background|chat.toggle|scope.enter|scope.get|appearance.apply>');
      process.exit(1);
    }
    if (options.city && !params.cityId) (params as any).cityId = options.city;
    const out = await dockAction(op, params, facadeCtx(options));
    printEnvelope(out, options);
    process.exit(out.ok ? 0 : 1);
  }
  if (subcommand === "scope") {
    const cityId = posArgs[0] || options.city;
    if (!cityId) {
      console.error("Error: Usage: polydocks dock scope <cityId>");
      process.exit(1);
    }
    const out = await dockAction("scope.enter", { cityId }, facadeCtx(options));
    printEnvelope(out, options);
    process.exit(out.ok ? 0 : 1);
  }
  if (subcommand === "appearance") {
    const { input } = parseContractFlags(rawTail);
    const out = await dockAction("appearance.apply", { ...input, ...(options.city ? { cityId: options.city } : {}) }, facadeCtx(options));
    printEnvelope(out, options);
    process.exit(out.ok ? 0 : 1);
  }
  console.error(`Unknown dock subcommand "${subcommand}". Use "tabs", "action", "scope", or "appearance".`);
  process.exit(1);
}

/** agent <status|models|memory|task|approve|session> — same handlers as /api/agent. */
async function handleAgentSurface(
  subcommand: string | undefined,
  rawTail: string[],
  options: CliOptions
): Promise<void> {
  const { parseContractFlags } = await import("../server/plugins/contractCli");
  const shared = await import("../server/facade/shared");
  const { input } = parseContractFlags(rawTail);
  const params = { ...input, ...(options.city ? { cityId: options.city } : {}), ...(options.workspace ? { workspaceId: options.workspace } : {}) };
  let out: unknown;
  switch (subcommand) {
    case "status":
      out = await shared.agentStatus();
      break;
    case "models":
      out = await shared.agentModels();
      break;
    case "memory":
      if (params.op !== "recall" && params.op !== "record") {
        console.error("Error: agent memory needs --op <recall|record>.");
        process.exit(1);
      }
      out = await shared.agentMemory(params.op, params, facadeCtx(options));
      break;
    case "task":
      if (params.op !== "list" && params.op !== "cancel") {
        console.error("Error: agent task needs --op <list|cancel>.");
        process.exit(1);
      }
      out = await shared.agentTask(params.op, params);
      break;
    case "approve":
      if (params.op !== "list" && params.op !== "resolve") {
        console.error("Error: agent approve needs --op <list|resolve>.");
        process.exit(1);
      }
      out = await shared.agentApprovals(params.op, params);
      break;
    case "session":
      if (params.op !== "list" && params.op !== "resume") {
        console.error("Error: agent session needs --op <list|resume>.");
        process.exit(1);
      }
      out = await shared.agentSession(params.op, params, facadeCtx(options));
      break;
    default:
      console.error(`Unknown agent subcommand "${subcommand}". Use "run", "status", "models", "memory", "task", "approve", or "session".`);
      process.exit(1);
  }
  printEnvelope(out, options);
  process.exit((out as any)?.ok ? 0 : 1);
}

async function handleAgentRun(
  posArgs: string[],
  options: CliOptions
): Promise<void> {
  const prompt = posArgs.join(" ").trim();
  if (!prompt) {
    console.error("Error: Missing required prompt argument for 'agent run \"<prompt>\"'");
    process.exit(1);
  }

  const stepEvents: AgentStepEvent[] = [];

  const onEvent = async (event: AgentStepEvent) => {
    stepEvents.push(event);
    if (!options.json) {
      if (event.type === "agent.start") {
        console.log(`✦ [agent.start] Prompt: "${prompt}"`);
      } else if (event.type === "tool.start") {
        console.log(`✦ [tool.start] ${event.payload?.name}`);
      } else if (event.type === "tool.done") {
        console.log(`✦ [tool.done] ${event.payload?.name}`);
      } else if (event.type === "error") {
        console.error(`✦ [error] ${event.payload?.message || "Execution error"}`);
      }
    }
  };

  let mockLlmClient: any = undefined;
  if (process.env.POLYMAX_CLI_MOCK_LLM === "true") {
    mockLlmClient = {
      chat: {
        completions: {
          create: async () => ({
            choices: [
              {
                message: {
                  role: "assistant",
                  content: `Polymax agent processed: "${prompt}"`,
                },
              },
            ],
          }),
        },
      },
    };
  }

  const result = await runAgentLoop({
    prompt,
    cityId: options.city,
    origin: "cli",
    onEvent,
    maxSteps: options.maxSteps,
    llmClient: mockLlmClient,
  });

  if (options.json) {
    console.log(JSON.stringify({ result, events: stepEvents }, null, 2));
    return;
  }

  console.log("\n--------------------------------------------------");
  console.log("Agent Response:");
  console.log(result.text || (result.status === "error" ? `Error: ${result.error}` : "(No text response)"));
  console.log(`\nStatus: ${result.status} (${result.steps} steps)`);
}

async function main(): Promise<void> {
  const rawArgs = process.argv.slice(2);
  if (rawArgs.length === 0 || rawArgs.includes("--help") || rawArgs.includes("-h")) {
    printUsage();
    process.exit(0);
  }

  const { command, subcommand, positional, options } = parseCliArgs(rawArgs);

  try {
    switch (command) {
      case "status":
        await handleStatus(options);
        break;
      case "sessions":
        await handleSessions(subcommand, positional, options);
        break;
      case "tasks":
        await handleTasks(subcommand, options);
        break;
      case "plugins":
        if (subcommand === "invoke") {
          // Tail after `plugins invoke`: keep flags for the capability input.
          const tail = rawArgs.slice(rawArgs.indexOf("invoke") + 1);
          await handlePluginsInvoke(positional, tail, options);
          break;
        }
        if (subcommand === "lifecycle") {
          const tail = rawArgs.slice(rawArgs.indexOf("lifecycle") + 1);
          await handlePluginsLifecycle(positional, tail, options);
          break;
        }
        if (subcommand === "versions" || subcommand === "rollback") {
          const tail = rawArgs.slice(rawArgs.indexOf(subcommand) + 1);
          await handlePluginsVersions(positional, tail, subcommand, options);
          break;
        }
        await handlePlugins(subcommand, positional, options);
        break;
      case "dock": {
        const idx = rawArgs.indexOf(subcommand ?? "");
        const tail = idx >= 0 ? rawArgs.slice(idx + 1) : [];
        await handleDock(subcommand, positional, tail, options);
        break;
      }
      case "agent":
        if (subcommand === "run") {
          await handleAgentRun(positional, options);
        } else if (["status", "models", "memory", "task", "approve", "session"].includes(subcommand ?? "")) {
          const idx = rawArgs.indexOf(subcommand ?? "");
          const tail = idx >= 0 ? rawArgs.slice(idx + 1) : [];
          await handleAgentSurface(subcommand, tail, options);
        } else {
          console.error(`Unknown agent subcommand "${subcommand}". Use "run", "status", "models", "memory", "task", "approve", or "session".`);
          process.exit(1);
        }
        break;
      default: {
        // Contract capabilities: `polydocks <plugin> <capability> [--key value] [--json]`
        const { runContractCommand } = await import("../server/plugins/contractCli");
        const { found, envelope, exitCode } = await runContractCommand(command, subcommand, rawArgs.slice(2), {
          json: options.json,
          city: options.city,
          workspace: options.workspace,
        });
        if (found) {
          if (options.json) {
            console.log(JSON.stringify(envelope, null, 2));
          } else if ((envelope as any)?.ok) {
            const data = (envelope as any).data;
            console.log(typeof data === "string" ? data : JSON.stringify(data, null, 2));
            for (const e of (envelope as any).events ?? []) {
              console.log(`[event ${e.type}]`);
            }
          } else {
            console.error(`Error: ${(envelope as any)?.error || "Capability failed."}`);
          }
          process.exit(exitCode ?? 0);
        }
        console.error(`Unknown command "${command}". Run "polydocks --help" for usage.`);
        process.exit(1);
      }
    }
  } catch (err: any) {
    if (options.json) {
      console.log(JSON.stringify({ error: err.message || String(err) }));
    } else {
      console.error(`Error: ${err.message || String(err)}`);
    }
    process.exit(1);
  }
}

if (import.meta.main) {
  await main();
}
